# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Server
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/safar360

# Auth secrets (needed once the identity module is built — set them now so day 2 isn't blocked)
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Signs/verifies the mock payment gateway's webhook calls (server/src/services/payment-gateway.mock.js)
WEBHOOK_SECRET=replace_with_a_third_long_random_string

# development | production — gates the dev-only magic OTP bypass (419027) and dev-only response fields
NODE_ENV=development
